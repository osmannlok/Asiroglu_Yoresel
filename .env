# =============================================================================
# Aşıroğlu Yöresel Market - Ortam ayarları (şablon)
# Kullanım: bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
#   cp .env.example .env
# .env dosyasını ASLA Git'e eklemeyin.
# =============================================================================

# --- Uygulama ---------------------------------------------------------------
# Yerelde: local | Canlıda: production
APP_ENV=local

# Hata ayrıntıları yalnızca APP_ENV production DEĞİLSE ve true ise gösterilir
APP_DEBUG=true

# Sonunda "/" olmadan. Boş bırakılabilir (göreli adresler kullanılır).
# Örnek yerel: http://localhost:8000
APP_URL=

APP_TIMEZONE=Europe/Istanbul

# --- Oturum -----------------------------------------------------------------
SESSION_NAME=ASIROGLU_SESSID
# Saniye cinsinden boşta kalma süresi (7200 = 2 saat)
SESSION_LIFETIME=7200
# Canlıda SSL aktif olunca true yapın. Boş bırakılırsa HTTPS otomatik algılanır.
SESSION_SECURE=
SESSION_SAMESITE=Lax

# --- Veritabanı -------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asiroglu_yoresel
DB_USERNAME=root
# Şifrede " #" (boşluk + diyez) varsa şifreyi çift tırnak içine alın
DB_PASSWORD="CompScience10#"
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci