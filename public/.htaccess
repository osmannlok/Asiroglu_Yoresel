# =============================================================================
# Aşıroğlu Yöresel Market - public/.htaccess
# Apache için URL yönlendirme ve temel güvenlik ayarları
# Gereksinim: mod_rewrite (zorunlu), mod_headers (önerilir)
# =============================================================================

# Dizin içeriklerinin listelenmesini kapat
Options -Indexes -MultiViews

# Varsayılan karakter kodlaması
AddDefaultCharset UTF-8

# -----------------------------------------------------------------------------
# 1. URL yönlendirme (Front Controller)
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Proje bir alt klasörde çalışıyorsa (örn. localhost/ashiroglu-market/public)
    # aşağıdaki satırı açıp yolu düzenleyin:
    # RewriteBase /ashiroglu-market/public/

    # --- Canlı ortamda SSL aktif olduktan sonra bu 3 satırı açın ---
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Gizli dosya ve klasörlere (.env, .git, .htaccess vb.) erişimi engelle
    # (".well-known" SSL doğrulaması için hariç tutulur)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Yüklenen dosyalar içinde PHP çalıştırmayı engelle
    RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar|pht|inc)$ - [F,L,NC]

    # Authorization başlığını PHP'ye aktar (ileride API/webhook için gerekebilir)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # İstenen yol gerçek bir dosya veya klasör değilse index.php'ye gönder
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# -----------------------------------------------------------------------------
# 2. Hassas dosya türlerine doğrudan erişimi engelle
# -----------------------------------------------------------------------------
<FilesMatch "\.(env|ini|log|sql|bak|sh|md|lock|json|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# -----------------------------------------------------------------------------
# 3. Güvenlik başlıkları
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    # MIME türü tahminini engelle
    Header always set X-Content-Type-Options "nosniff"

    # Site başka bir sitede iframe içinde açılamasın (clickjacking koruması)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Dış sitelere gönderilen referrer bilgisini sınırla
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Kullanılmayan tarayıcı özelliklerini kapat
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # PHP sürüm bilgisini gizle
    Header unset X-Powered-By

    # --- SSL aktif olduktan sonra açın (HSTS) ---
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# -----------------------------------------------------------------------------
# 4. Performans: sıkıştırma ve tarayıcı önbelleği
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>